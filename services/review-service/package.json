{
  "name": "@distill/review-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc",
    "prebuild": "npx prisma generate --schema=src/infrastructure/persistence/prisma/schema.prisma",
    "start": "node dist/bootstrap.js",
    "pretest": "npx prisma generate --schema=src/infrastructure/persistence/prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "prelint": "npx prisma generate --schema=src/infrastructure/persistence/prisma/schema.prisma",
    "lint": "eslint .",
    "pretypecheck": "npx prisma generate --schema=src/infrastructure/persistence/prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@distill/types": "*",
    "@distill/utils": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@prisma/client": "^5.12.1",
    "amqplib": "^0.10.3",
    "fastify": "^4.26.2",
    "fastify-type-provider-zod": "^1.2.0",
    "pino": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.12.7",
    "prisma": "^5.12.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
